# Xtin AI Coach - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - keep it private!

# Backend Server Configuration
# Leave empty for relative API paths (recommended for same-domain deployments)
# Use full URL (e.g., https://your-api.com) only if backend is on different domain
BACKEND_URL=

# OpenAI API key used by the FastAPI backend AI endpoints
OPENAI_API_KEY=your_openai_api_key_here

# Xtin Journal Supabase project (frontend/public anon key only)
XTIN_JOURNAL_SUPABASE_URL=https://your-project.supabase.co
XTIN_JOURNAL_SUPABASE_ANON_KEY=your_supabase_anon_key

# CORS Configuration (comma-separated list of allowed origins)
# Leave empty to allow all origins (development)
# Set to your domain(s) for production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Development Server Port (optional, defaults to 8001)
PORT=8001

# API Configuration
API_VERSION=v2
