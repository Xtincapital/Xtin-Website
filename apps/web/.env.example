# =============================================================================
# XTIN Capital — Frontend (Vite) environment
# =============================================================================
# Copy to `.env` and fill in. ONLY `VITE_`-prefixed vars are bundled into the
# client; anything else here does nothing and must NOT be added (no service
# keys, no JWT secret, no SMTP/Stripe secrets — those live in the backend only).
# `.env` is gitignored.

# --- Backend (Express API) base URL -----------------------------------------
# No trailing slash. Local backend defaults to port 5002 (see backend/.env).
VITE_BACKEND_URL=http://localhost:5002

# --- Supabase (browser client — anon key only) ----------------------------
# Currently hardcoded in src/supabase/index.js; these vars will replace it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Sign-In (GIS token client in src/utils/googleAuth.js) ----------
VITE_GOOGLE_CLIENT_ID=

# --- Certificate verification public URL -----------------------------------
VITE_VERIFICATION_URL=https://www.xtincapital.com/verify

# --- Admin allow-list (client-side gate for /admin/certificates) -----------
VITE_ADMIN_EMAIL=

# --- Razorpay advisory button (marketing) --------------------------------
VITE_RAZORPAY_ADVISORY_BUTTON_ID=

# --- Standalone sub-app links (used until they are merged in) --------------
# Defaults point at production; override to run locally.
VITE_GINI_URL=https://www.xtingini.in
VITE_JOURNAL_URL=https://www.xtinjournal.website
VITE_FUNDAMENTAL_URL=https://fundakamental.in
VITE_BACKTEST_URL=https://backtest.xtincapital.com

# --- DEV ONLY: bypass sign-in with a mock user. MUST be unset/false in prod.
VITE_AUTH_BYPASS=false

# --- Legacy: Python AI service base URL (ChatWidget). ---------------------
# Being folded into the Express API — will be removed. Leave blank if unused.
VITE_API_BASE_URL=
