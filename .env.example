# =============================================================================
# Repo-root .env  (mostly redundant — prefer backend/.env)
# =============================================================================
# This file only exists because some newsletter/cron scripts get run from the
# repo root and dotenv loads `.env` from the current working directory.
#
# The authoritative backend env template is `backend/sample.env`. If you can
# always run those scripts from inside `backend/`, DELETE the root `.env`
# entirely (see documents/migration/PHASE-0-secret-rotation.md).
#
# NEVER commit real values. `.env` is gitignored.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

GROQ_API_KEY=

# Gmail SMTP (newsletter + advisor-application mail). Use a Gmail App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-gmail@gmail.com
