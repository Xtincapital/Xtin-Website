{# Nunjucks port of templates/pdf/analysis_report.html (Jinja2), REBOUND to
   the real `funda_reports` / `AnalysisReportResponse` data shape instead of
   the Python template's original ad hoc dict (ticker, company_name,
   current_price, recommendation, valuation, weaknesses, risk_level,
   risk_factors, ...) — none of those columns exist on `funda_reports`; they
   were written against the same nonexistent `analysis_reports` table this
   port's bug fix replaces (see reports.repository.ts / pdfExport section of
   reports.controller.ts). Visual design (header, score box, metrics grid,
   two-column lists, callout boxes, disclaimer, footer) is copied faithfully
   from the original; only the field bindings changed to match:
     company, ticker, exchange, date, overall_score, summary,
     metrics.{profitability,liquidity,solvency,efficiency}.{score,label},
     key_ratios[].{name,value,benchmark}, strengths[], red_flags[],
     investment_assessment, plain_english, personalized_take, bull_case[],
     bear_case[], what_to_watch[], peer_context, data_confidence.
#}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Fundamental Analysis Report - {{ ticker }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.6;
            color: #1a1a1a;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 3px solid #2563eb;
        }

        .header h1 {
            font-size: 28pt;
            color: #2563eb;
            margin-bottom: 10px;
        }

        .header .ticker {
            font-size: 20pt;
            font-weight: bold;
            color: #1a1a1a;
            margin-bottom: 5px;
        }

        .header .company-name {
            font-size: 14pt;
            color: #666;
            margin-bottom: 10px;
        }

        .header .meta {
            font-size: 9pt;
            color: #999;
        }

        .score-box {
            background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
            color: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
            text-align: center;
        }

        .score-box .label {
            font-size: 10pt;
            opacity: 0.9;
            margin-bottom: 5px;
        }

        .score-box .value {
            font-size: 24pt;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .score-box .rating {
            font-size: 14pt;
        }

        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }

        .section-title {
            font-size: 16pt;
            font-weight: bold;
            color: #2563eb;
            margin-bottom: 15px;
            padding-bottom: 5px;
            border-bottom: 2px solid #e5e7eb;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .metric-card {
            background: #f9fafb;
            padding: 15px;
            border-radius: 6px;
            border-left: 4px solid #2563eb;
        }

        .metric-card .label {
            font-size: 9pt;
            color: #666;
            margin-bottom: 5px;
        }

        .metric-card .value {
            font-size: 16pt;
            font-weight: bold;
            color: #1a1a1a;
        }

        .metric-card .sub-label {
            font-size: 9pt;
            color: #2563eb;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th {
            background: #f3f4f6;
            color: #374151;
            font-weight: 600;
            text-align: left;
            padding: 10px 12px;
            border-bottom: 2px solid #d1d5db;
        }

        td {
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
        }

        .list-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .list-box {
            background: #f9fafb;
            padding: 15px;
            border-radius: 6px;
        }

        .list-box.strengths {
            border-left: 4px solid #059669;
        }

        .list-box.red-flags {
            border-left: 4px solid #dc2626;
        }

        .list-box.bull {
            border-left: 4px solid #059669;
        }

        .list-box.bear {
            border-left: 4px solid #dc2626;
        }

        .list-box h3 {
            font-size: 12pt;
            margin-bottom: 10px;
        }

        .list-box.strengths h3,
        .list-box.bull h3 {
            color: #059669;
        }

        .list-box.red-flags h3,
        .list-box.bear h3 {
            color: #dc2626;
        }

        .list-box ul {
            list-style: none;
        }

        .list-box li {
            padding: 5px 0;
            padding-left: 16px;
            position: relative;
        }

        .list-box.strengths li:before,
        .list-box.bull li:before {
            content: "+";
            position: absolute;
            left: 0;
            color: #059669;
            font-weight: bold;
        }

        .list-box.red-flags li:before,
        .list-box.bear li:before {
            content: "-";
            position: absolute;
            left: 0;
            color: #dc2626;
            font-weight: bold;
        }

        .callout {
            background: #fef3c7;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #f59e0b;
        }

        .callout h3 {
            color: #b45309;
            font-size: 12pt;
            margin-bottom: 10px;
        }

        .callout p {
            color: #78350f;
            line-height: 1.8;
        }

        .watch-list {
            background: #f9fafb;
            padding: 15px;
            border-radius: 6px;
        }

        .watch-list ul {
            margin-left: 18px;
        }

        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 2px solid #e5e7eb;
            text-align: center;
            font-size: 9pt;
            color: #999;
        }

        .disclaimer {
            background: #fef2f2;
            border: 1px solid #fecaca;
            padding: 15px;
            border-radius: 6px;
            margin-top: 20px;
            font-size: 9pt;
            color: #991b1b;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <h1>Fundamental Analysis Report</h1>
        <div class="ticker">{{ ticker }}{% if exchange %} &middot; {{ exchange }}{% endif %}</div>
        <div class="company-name">{{ company }}</div>
        <div class="meta">Report date: {{ date }} &nbsp;|&nbsp; Generated on {{ generated_at }}</div>
    </div>

    <!-- Overall Score -->
    <div class="score-box">
        <div class="label">OVERALL SCORE</div>
        <div class="value">{{ overall_score | fixed(1) }} / 10</div>
        {% if plain_english %}
        <div class="rating">{{ plain_english }}</div>
        {% endif %}
    </div>

    <!-- Summary -->
    {% if summary %}
    <div class="section">
        <h2 class="section-title">Executive Summary</h2>
        <p>{{ summary }}</p>
    </div>
    {% endif %}

    <!-- Financial Health Metrics -->
    {% if metrics %}
    <div class="section">
        <h2 class="section-title">Financial Health Metrics</h2>
        <div class="metrics-grid">
            {% if metrics.profitability %}
            <div class="metric-card">
                <div class="label">Profitability</div>
                <div class="value">{{ metrics.profitability.score }}</div>
                {% if metrics.profitability.label %}<div class="sub-label">{{ metrics.profitability.label }}</div>{% endif %}
            </div>
            {% endif %}

            {% if metrics.liquidity %}
            <div class="metric-card">
                <div class="label">Liquidity</div>
                <div class="value">{{ metrics.liquidity.score }}</div>
                {% if metrics.liquidity.label %}<div class="sub-label">{{ metrics.liquidity.label }}</div>{% endif %}
            </div>
            {% endif %}

            {% if metrics.solvency %}
            <div class="metric-card">
                <div class="label">Solvency</div>
                <div class="value">{{ metrics.solvency.score }}</div>
                {% if metrics.solvency.label %}<div class="sub-label">{{ metrics.solvency.label }}</div>{% endif %}
            </div>
            {% endif %}

            {% if metrics.efficiency %}
            <div class="metric-card">
                <div class="label">Efficiency</div>
                <div class="value">{{ metrics.efficiency.score }}</div>
                {% if metrics.efficiency.label %}<div class="sub-label">{{ metrics.efficiency.label }}</div>{% endif %}
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <!-- Key Ratios -->
    {% if key_ratios and key_ratios.length %}
    <div class="section">
        <h2 class="section-title">Key Ratios</h2>
        <table>
            <thead>
                <tr>
                    <th>Ratio</th>
                    <th>Value</th>
                    <th>Benchmark</th>
                </tr>
            </thead>
            <tbody>
                {% for ratio in key_ratios %}
                <tr>
                    <td><strong>{{ ratio.name }}</strong></td>
                    <td>{{ ratio.value }}</td>
                    <td>{{ ratio.benchmark }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- Strengths & Red Flags -->
    <div class="section">
        <h2 class="section-title">Analysis Summary</h2>
        <div class="list-section">
            <div class="list-box strengths">
                <h3>Strengths</h3>
                <ul>
                    {% for strength in strengths %}
                    <li>{{ strength }}</li>
                    {% endfor %}
                    {% if not strengths or not strengths.length %}
                    <li>No specific strengths identified</li>
                    {% endif %}
                </ul>
            </div>

            <div class="list-box red-flags">
                <h3>Red Flags</h3>
                <ul>
                    {% for flag in red_flags %}
                    <li>{{ flag }}</li>
                    {% endfor %}
                    {% if not red_flags or not red_flags.length %}
                    <li>No red flags identified</li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>

    <!-- Investment Assessment -->
    {% if investment_assessment %}
    <div class="section">
        <h2 class="section-title">Investment Assessment</h2>
        <p>{{ investment_assessment }}</p>
    </div>
    {% endif %}

    <!-- Personalized Take (Pro) -->
    {% if personalized_take %}
    <div class="section">
        <div class="callout">
            <h3>Personalized Take</h3>
            <p>{{ personalized_take }}</p>
        </div>
    </div>
    {% endif %}

    <!-- Bull / Bear Case (Pro) -->
    {% if (bull_case and bull_case.length) or (bear_case and bear_case.length) %}
    <div class="section">
        <h2 class="section-title">Bull Case vs. Bear Case</h2>
        <div class="list-section">
            <div class="list-box bull">
                <h3>Bull Case</h3>
                <ul>
                    {% for point in bull_case %}
                    <li>{{ point }}</li>
                    {% endfor %}
                    {% if not bull_case or not bull_case.length %}
                    <li>Not available</li>
                    {% endif %}
                </ul>
            </div>
            <div class="list-box bear">
                <h3>Bear Case</h3>
                <ul>
                    {% for point in bear_case %}
                    <li>{{ point }}</li>
                    {% endfor %}
                    {% if not bear_case or not bear_case.length %}
                    <li>Not available</li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- What to Watch (Pro) -->
    {% if what_to_watch and what_to_watch.length %}
    <div class="section">
        <h2 class="section-title">What to Watch</h2>
        <div class="watch-list">
            <ul>
                {% for item in what_to_watch %}
                <li>{{ item }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    <!-- Peer Context (Pro) -->
    {% if peer_context %}
    <div class="section">
        <h2 class="section-title">Peer Context</h2>
        <p>{{ peer_context }}</p>
    </div>
    {% endif %}

    <!-- Data Confidence (Pro) -->
    {% if data_confidence %}
    <div class="section">
        <h2 class="section-title">Data Confidence</h2>
        <table>
            <tbody>
                {% for key, value in data_confidence %}
                <tr>
                    <td><strong>{{ key }}</strong></td>
                    <td>{{ value }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- Disclaimer -->
    <div class="disclaimer">
        <strong>Disclaimer:</strong> This report is for informational purposes only and does not constitute financial advice.
        Always conduct your own research and consult with a qualified financial advisor before making investment decisions.
        Past performance does not guarantee future results.
    </div>

    <!-- Footer -->
    <div class="footer">
        <div>Generated by {{ app_name }}</div>
        <div>&copy; {{ current_year }} All rights reserved</div>
    </div>
</body>
</html>
