{
  "name": "@xtin-capital/api",
  "version": "1.0.0",
  "description": "XTIN Capital Express API",
  "license": "ISC",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "worker": "tsx worker.ts",
    "debug-cron": "tsx debug-cron.ts",
    "cron:morning": "tsx run-newsletter-cron.ts morning",
    "cron:evening": "tsx run-newsletter-cron.ts evening",
    "cron:keep-alive": "tsx keep-alive.ts",
    "test-newsletter": "tsx -e 'import(\"./utils/newsletterGeneratorSimple.ts\").then(({generateAndSendNewsletter}) => generateAndSendNewsletter()).then(r => console.log(\"Result:\", JSON.stringify(r, null, 2))).catch(console.error)'",
    "generate-newsletter": "tsx -e 'import(\"./utils/newsletterGeneratorSimple.ts\").then(({generateNewsletter}) => generateNewsletter()).then(r => console.log(\"Generated:\", r.title)).catch(console.error)'",
    "send-newsletter": "tsx send-newsletter-smtp.ts",
    "postinstall": "npx puppeteer browsers install chrome && echo 'Backend dependencies installed successfully'"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@sendgrid/mail": "^7.7.0",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.13.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.2",
    "nodemailer": "^7.0.12",
    "nunjucks": "^3.2.4",
    "openai": "^6.15.0",
    "pdf-parse": "^1.1.4",
    "puppeteer": "^25.11.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^4.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
