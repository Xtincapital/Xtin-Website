# Server
PORT=5002
NODE_ENV=development

# Supabase — service-role key has full DB access and bypasses RLS; never
# expose it to the frontend. Get all three from Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: allowed CORS origins are hardcoded in app.ts, not read from env —
# ALLOWED_ORIGINS/FRONTEND_URL/CORS_ORIGIN below are not currently wired up
# to anything; update the array in app.ts directly if the frontend origin
# changes.

# AI provider
# Paste your Claude API key here when you purchase it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional fallback providers used only when ANTHROPIC_API_KEY is empty.
GROQ_API_KEY=
OPENAI_API_KEY=

# Substack publication base URL used to fetch articles for the Newsletter page.
# Defaults to https://chetandugar.substack.com if unset.
SUBSTACK_URL=https://chetandugar.substack.com

# Email (Gmail SMTP) — used for newsletters and advisor-application notifications.
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), NOT your
# normal password, and make sure 2FA is enabled on the account.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-gmail@gmail.com

# Where "Join as Advisor" application notifications are sent.
# Optional — defaults to EMAIL_USER if unset.
ADVISOR_NOTIFICATION_EMAIL=

# Razorpay (Xtin Academy Learn Pro checkout)
# Get keys from https://dashboard.razorpay.com → Settings → API Keys.
# The Learn Pro plan is granted server-side ONLY after HMAC verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Razorpay Dashboard → Webhooks
# (URL: <backend>/api/payments/razorpay/webhook, event: order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Shared secret the external cron trigger (cron-job.org) must pass as
# ?token=... to POST /api/trigger-newsletter. Generate any random string.
CRON_SECRET_TOKEN=

# Admin alerts (new algo publisher applications). With RESEND_API_KEY set they go via Resend
# (recommended — doesn't use the Gmail daily quota); otherwise they fall back to SMTP above.
# Recipients = xtincapital@gmail.com + ADMIN_EMAILS.
RESEND_API_KEY=
RESEND_FROM=Xtin Capital <alerts@yourdomain.com>
FRONTEND_URL=https://www.xtincapital.com
