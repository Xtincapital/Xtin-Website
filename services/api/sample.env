# Server
PORT=5002
NODE_ENV=development

# Supabase — service-role key has full DB access and bypasses RLS; never
# expose it to the frontend. Get all three from Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: allowed CORS origins are hardcoded in app.ts, not read from env —
# ALLOWED_ORIGINS/FRONTEND_URL/CORS_ORIGIN below are not currently wired up
# to anything; update the array in app.ts directly if the frontend origin
# changes.

# AI provider
# Paste your Claude API key here when you purchase it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional fallback providers used only when ANTHROPIC_API_KEY is empty.
GROQ_API_KEY=
OPENAI_API_KEY=

# Substack publication base URL used to fetch articles for the Newsletter page.
# Defaults to https://chetandugar.substack.com if unset.
SUBSTACK_URL=https://chetandugar.substack.com

# Email (Gmail SMTP) — used for newsletters and advisor-application notifications.
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), NOT your
# normal password, and make sure 2FA is enabled on the account.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-gmail@gmail.com

# Where "Join as Advisor" application notifications are sent.
# Optional — defaults to EMAIL_USER if unset.
ADVISOR_NOTIFICATION_EMAIL=

# Razorpay (Xtin Academy Learn Pro checkout)
# Get keys from https://dashboard.razorpay.com → Settings → API Keys.
# The Learn Pro plan is granted server-side ONLY after HMAC verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Razorpay Dashboard → Webhooks
# (URL: <backend>/api/payments/razorpay/webhook, event: order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Shared secret the external cron trigger (cron-job.org) must pass as
# ?token=... to POST /api/trigger-newsletter. Generate any random string.
CRON_SECRET_TOKEN=

# Admin alerts (new algo publisher applications). With RESEND_API_KEY set they go via Resend
# (recommended — doesn't use the Gmail daily quota); otherwise they fall back to SMTP above.
# Recipients = xtincapital@gmail.com + ADMIN_EMAILS.
RESEND_API_KEY=
RESEND_FROM=Xtin Capital <alerts@yourdomain.com>
FRONTEND_URL=https://www.xtincapital.com


# Broker sync (XTS): the Journal pulls a customer's executed trades from their broker.
# Off by default. Turning it on needs XTS_SYNC_ENABLED=true AND an adapter below.
# Daily run: POST <backend>/api/trigger-broker-sync?token=<CRON_SECRET_TOKEN>, after the market closes.
XTS_SYNC_ENABLED=false
# "xts" = the real adapter (needs the settings below); "mock" = sample executions for trying the
# pipeline (ignored in production). Anything else = no adapter.
XTS_ADAPTER=
# The broker's XTS Interactive API, including its path prefix, e.g. https://host/interactive.
# Not needed if you use the host lookup below (it returns this address).
XTS_BASE_URL=
# The key pair the broker issues for the Interactive API. XTS allows ONE session per pair, so
# only one server process may sync with it.
XTS_APP_KEY=
XTS_SECRET_KEY=
# Optional host lookup, if the broker's setup uses it: both the URL and the password are needed.
XTS_HOSTLOOKUP_URL=
XTS_ACCESS_PASSWORD=
# Version string sent to the host lookup (the docs print both 1.0.1 and 1.0.2).
XTS_API_VERSION=interactive_1.0.1
# Optional: send broker traffic through a proxy with a fixed address (if the broker whitelists addresses).
# http://user:password@host:port. If set but unreachable, broker calls fail rather than going direct.
XTS_PROXY_URL=
# Optional trial group: only these customers (comma-separated emails), and admins, can link a broker
# account or sync by hand. Leave empty to open sync to every Journal Pro customer. Someone already linked
# keeps being read if taken off the list.
BROKER_SYNC_PILOT_EMAILS=
# The server runs the sync itself at 3:45 PM, 5:30 PM and 11:45 PM IST (weekdays) once XTS_SYNC_ENABLED=true,
# and catches up after a restart. Set true to turn that off on this process (e.g. the web service, when a
# worker does it, or when only the outside trigger is used). Only one sync ever runs at a time.
DISABLE_BROKER_SYNC_CRON=
